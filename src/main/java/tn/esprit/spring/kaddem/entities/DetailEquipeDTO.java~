package tn.esprit.spring.kaddem.entities;

import java.io.Serializable;

import javax.persistence.*;

@Entity
public class DetailEquipeDTO implements Serializable{
    @Id
    @GeneratedValue(strategy= GenerationType.IDENTITY)
    private Integer idDetailEquipe;
    private Integer salle;
    private String thematique;
    @OneToOne(mappedBy="detailEquipe")
    private EquipeDTO equipeDTO;
    public DetailEquipeDTO() {

    }

    public DetailEquipeDTO(Integer salle, String thematique) {
        super();
        this.salle = salle;
        this.thematique = thematique;
    }

    public DetailEquipeDTO(Integer idDetailEquipe, Integer salle, String thematique) {
        super();
        this.idDetailEquipe = idDetailEquipe;
        this.salle = salle;
        this.thematique = thematique;
    }

    public EquipeDTO getEquipe() {
        return equipeDTO;
    }

    public void setEquipe(EquipeDTO equipeDTO) {
        this.equipeDTO = equipeDTO;
    }

    public Integer getIdDetailEquipe() {
        return idDetailEquipe;
    }
    public void setIdDetailEquipe(Integer idDetailEquipe) {
        this.idDetailEquipe = idDetailEquipe;
    }
    public Integer getSalle() {
        return salle;
    }
    public void setSalle(Integer salle) {
        this.salle = salle;
    }
    public String getThematique() {
        return thematique;
    }
    public void setThematique(String thematique) {
        this.thematique = thematique;
    }

}
